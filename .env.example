# ============================================
# WHATSAPP BUSINESS API
# ============================================
# GET FROM: https://developers.facebook.com/apps → Your App → WhatsApp → API Setup
WHATSAPP_GRAPH_BASE=https://graph.facebook.com
WHATSAPP_API_VERSION=v24.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ============================================
# TELEGRAM BOT
# ============================================
# GET FROM: https://t.me/BotFather → /newbot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ============================================
# AZURE OPENAI (OPTIONAL - AI features)
# ============================================
# GET FROM: https://portal.azure.com → Your OpenAI Resource → Keys and Endpoint
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ============================================
# LLM SETTINGS
# ============================================
LLM_MAX_TOKENS=800
LLM_TEMPERATURE=0.7
LLM_MAX_HISTORY_MESSAGES=20

# ============================================
# SESSION CONFIGURATION
# ============================================
SESSION_TIMEOUT_MINUTES=10080
SESSION_CLEANUP_INTERVAL_MINUTES=3600

# ============================================
# FLIGHT PRICING - AMADEUS
# ============================================
# GET FROM: https://developers.amadeus.com → My Apps → Create App
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_ISSUER=AirlineServiceManagement
JWT_AUDIENCE=AirlineServiceManagement
JWT_EXPIRY_HOURS=24

# ============================================
# DATABASE
# ============================================
DATABASE_CONNECTION_STRING=Data Source=whatsappbot.db

# ============================================
# APPLICATION
# ============================================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000;https://localhost:5001

# ============================================
# BOT PERSONALITY
# ============================================
BOT_NAME=FemzyBot
BOT_COMPANY=FEMZYK ENTERPRISES LTD
BOT_SUPPORT_EMAIL=support@example.com

# ============================================
# ADMIN
# ============================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD

# ============================================
# OPTIONAL: CAPTCHA (self-hosted by default)
# ============================================
CAPTCHA_API_KEY=
CAPTCHA_SERVICE_PROVIDER=self

# ============================================
# OPTIONAL: STRIPE PAYMENTS
# ============================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================
# OPTIONAL: AZURE SPEECH
# ============================================
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# ============================================
# OPTIONAL: AZURE MULTIMODAL AI (vision / image / embeddings)
# Deployments inside the same Azure OpenAI resource;
# if empty, the corresponding service degrades gracefully.
# ============================================
AZURE_IMAGE_DEPLOYMENT=
AZURE_VISION_DEPLOYMENT=
AZURE_EMBEDDING_DEPLOYMENT=

# ============================================
# OPTIONAL: FEATURE FLAGS / SCRAPING INFRA
# ============================================
# Enable the /image command (true/false)
FEATURE_IMAGE_GENERATION=false
# Optional comma-separated proxy list for the booking automation (none = direct)
PROXY_LIST=
