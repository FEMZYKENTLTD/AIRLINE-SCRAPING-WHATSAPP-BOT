# WhatsApp Business API Configuration
WHATSAPP_GRAPH_BASE=https://graph.facebook.com
WHATSAPP_API_VERSION=v24.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# LLM Settings
LLM_MAX_TOKENS=800
LLM_TEMPERATURE=0.7
LLM_MAX_HISTORY_MESSAGES=20

# Session Configuration
SESSION_TIMEOUT_MINUTES=10080
SESSION_CLEANUP_INTERVAL_MINUTES=3600

# Scraping Configuration
SCRAPING_ENABLED=true
SCRAPING_RUN_ON_STARTUP=true
SCRAPING_INTERVAL_MINUTES=360
SCRAPING_USER_AGENT=WhatsAppBotScraper/1.0 (+contact: femzykenterprisesltd@gmail.com)
SCRAPING_REQUEST_TIMEOUT_SECONDS=25
SCRAPING_MAX_PAGES_PER_SITE=60
SCRAPING_MAX_DEPTH=2
SCRAPING_DELAY_BETWEEN_REQUESTS_MS=350

# Flight Pricing
FLIGHT_PRICING_ENABLE_AMADEUS=true
AMADEUS_BASE_URL=https://test.api.amadeus.com
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
FLIGHT_PRICING_ENABLE_SCRAPE_FALLBACK=true
FLIGHT_PRICING_ENABLE_DEEPLINK_FALLBACK=true

# CAPTCHA Service (Sign up at https://2captcha.com)
CAPTCHA_API_KEY=
CAPTCHA_SERVICE_PROVIDER=2captcha
CAPTCHA_SERVICE_URL=https://2captcha.com

# Database
DATABASE_CONNECTION_STRING=Data Source=whatsappbot.db

# Application
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000;https://localhost:5001
